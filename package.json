{
  "name": "promise-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "bot": "node --env-file=.env bot/index.ts",
    "test:extractor": "node --env-file=.env server/testsuite/extractor_test.ts",
    "server": "node --env-file=.env server/index.ts",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "emulate": "npm --prefix functions run build && npm run build && npx -y firebase-tools@15 emulators:start --only functions,hosting --project demo-promise-tracker",
    "deploy": "npx -y firebase-tools@15 deploy"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "spectrum-ts": "^12.10.1",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "^26.6.5",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "typescript-eslint": "latest"
  }
}
